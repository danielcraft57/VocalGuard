VG_ENV=prod

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://vocalguard:<db_password>@127.0.0.1:5432/vocalguard

# Async / queue (Redis)
CELERY_BROKER_URL=redis://:<redis_password>@127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://:<redis_password>@127.0.0.1:6379/3

# Runtime
MODEM_BAUDRATE=115200
VOICE_RECOGNITION_ENGINE=vosk
VOICE_SYNTHESIS_ENGINE=gtts
VOICE_LANGUAGE=fr
VOSK_MODEL_PATH=vosk-models/vosk-model-small-fr-0.22
RINGS_BEFORE_ANSWER=2
MAX_CALL_DURATION=300
VOICEMAIL_ENABLED=true
VOICEMAIL_MAX_DURATION=120

# Agenda / email
SMTP_HOST=mail.example.net
SMTP_PORT=587
SMTP_USER=agenda
SMTP_PASSWORD=<smtp_password>
SMTP_USE_TLS=true
SMTP_SENDER=agenda@example.net
PUBLIC_BASE_URL=https://app.example.net
API_PUBLIC_ADMIN_TOKEN=<strong_random_token>
AGENDA_PUBLIC_SECRET=<strong_random_secret>

# Telephony (daemon sur serveur ; deploy : scripts/deploy_telephony.ps1 -> .env sur node11)
# PC de dev : USE_TELEPHONY_DAEMON=1, TELEPHONY_DAEMON_URL=http://node11.lan:8090
# node11 : TELEPHONY_PUBLIC_API_URL = URL de l API principale joignable depuis le Pi (127.0.0.1 si API sur le meme hote)
USE_TELEPHONY_DAEMON=1
TELEPHONY_DAEMON_URL=http://127.0.0.1:8090
TELEPHONY_PUBLIC_API_URL=http://127.0.0.1:8000
TELEPHONY_INTERNAL_TOKEN=<meme_secret_api_et_daemon>
TELEPHONY_BIND_HOST=0.0.0.0
TELEPHONY_BIND_PORT=8090
# Optionnel : espacer les warnings si relais vers API indisponible (defaut 30 s)
# TELEPHONY_RELAY_WARN_INTERVAL_SEC=30

# OSINT
NUMLOOKUP_API_KEY=
OPENCNAM_API_KEY=
NUMVERIFY_API_KEY=
HLR_API_KEY=
SIRENE_API_KEY=
