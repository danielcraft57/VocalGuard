VG_ENV=prod

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://vocalguard:<db_password>@127.0.0.1:5432/vocalguard

# Async / queue (Redis)
CELERY_BROKER_URL=redis://:<redis_password>@127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://:<redis_password>@127.0.0.1:6379/3

# Runtime
MODEM_BAUDRATE=230400
MODEM_VOICE_VSM=129,11025
# Transcription : Whisper sur node15 uniquement (pas de Vosk local sur le Pi)
STT_SERVICE_URL=http://node15.lan:8100
STT_INTERNAL_TOKEN=<meme_secret_que_node15_/opt/vocalguard-stt/.env.stt>
# VOICE_RECOGNITION_ENGINE ignore si STT_SERVICE_URL est defini (pas de modele local)
VOICE_SYNTHESIS_ENGINE=gtts
VOICE_LANGUAGE=fr
# TTS distant (accueil / apercu incoming-audio / prefetch KB) — meme daemon node15
# TTS_SERVICE_URL=http://node15.lan:8100
# Pool Postgres (Pi : garder bas)
VG_DB_POOL_SIZE=5
VG_DB_MAX_OVERFLOW=10
# Threads asyncio (Vosk mix WAV, etc.) — defaut 2
VG_ASYNCIO_POOL_WORKERS=2
RINGS_BEFORE_ANSWER=2
MAX_CALL_DURATION=300
VOICEMAIL_ENABLED=true
VOICEMAIL_MAX_DURATION=120

# Agenda / email
SMTP_HOST=mail.example.net
SMTP_PORT=587
SMTP_USER=agenda
SMTP_PASSWORD=<smtp_password>
SMTP_USE_TLS=true
SMTP_SENDER=agenda@example.net
PUBLIC_BASE_URL=https://app.example.net
API_PUBLIC_ADMIN_TOKEN=<strong_random_token>

# Import ProspectLab (optionnel) : dossier phone_no_website_by_city sur le serveur API
# PROSPECT_LAB_DATA_DIR=/chemin/vers/ProspectLab/Data/phone_no_website_by_city
AGENDA_PUBLIC_SECRET=<strong_random_secret>

# Telephony (daemon sur serveur ; deploy : scripts/deploy_telephony.ps1 -> .env sur node14)
# PC Windows/Linux uniquement pour le backend SANS daemon local : USE_TELEPHONY_DAEMON=0 (sinon 502 sur appels sortants).
# PC qui pilote un Pi avec modem : USE_TELEPHONY_DAEMON=1 et TELEPHONY_DAEMON_URL=http://node14.lan:8090 (IP joignable !)
# Pi ou machine unique (API + daemon) : TELEPHONY_DAEMON_URL=http://127.0.0.1:8090
# node14 : TELEPHONY_PUBLIC_API_URL = URL de l API principale joignable depuis le Pi (127.0.0.1 si API sur le meme hote)
USE_TELEPHONY_DAEMON=1
TELEPHONY_DAEMON_URL=http://127.0.0.1:8090
TELEPHONY_PUBLIC_API_URL=http://127.0.0.1:8000
TELEPHONY_INTERNAL_TOKEN=<meme_secret_api_et_daemon>
TELEPHONY_BIND_HOST=0.0.0.0
TELEPHONY_BIND_PORT=8090
# Optionnel : espacer les warnings si relais vers API indisponible (defaut 30 s)
# TELEPHONY_RELAY_WARN_INTERVAL_SEC=30

# OSINT
# Worker distant PhoneInfoga (node15) — optionnel ; accélère l'enrichissement des prospects
# OSINT_SERVICE_URL=http://node15.lan:8110
# OSINT_INTERNAL_TOKEN=
# Parallele sync sans Celery quand OSINT_SERVICE_URL est defini (defaut 2, max 16)
# PROSPECT_PHONE_ENRICH_PARALLEL=2
NUMLOOKUP_API_KEY=
OPENCNAM_API_KEY=
NUMVERIFY_API_KEY=
HLR_API_KEY=
SIRENE_API_KEY=

# ElevenLabs TTS (accueil / KB) — ne jamais committer les vraies clefs
# ELEVENLABS_API_KEY=sk_xxx
# Pool multi-comptes (csv) : auto-switch si quota a 0 / 429
# ELEVENLABS_API_KEYS=sk_a...,sk_b...,sk_c...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
