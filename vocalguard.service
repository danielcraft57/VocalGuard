# Service systemd pour VocalGuard (mise en production sur Raspberry Pi)
# Installation :
#   sudo cp vocalguard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable vocalguard
#   sudo systemctl start vocalguard

[Unit]
Description=VocalGuard - API et interface web
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/VocalGuard
Environment="PATH=/home/pi/VocalGuard/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/pi/VocalGuard"
ExecStart=/home/pi/VocalGuard/venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vocalguard

[Install]
WantedBy=multi-user.target
