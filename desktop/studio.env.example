# Copiez ce fichier en studio.env a cote de l'exe et decommentez si besoin.
# Sinon le Studio recupere le token via node14 (/studio-config) quand l'API est a jour.

VG_STT_URL=http://node15.lan:8100
VG_VOICE_API=http://node14.lan:8000/api/v1
# VG_STT_TOKEN=coller_ici_STT_INTERNAL_TOKEN_node14_ou_node15
# VG_STT_TRANSCRIBE_MODE=live
# Gain micro (25 % a 250 %) et volume Marie (5 % a 100 %)
# VG_STUDIO_MIC_GAIN=1.00
# VG_STUDIO_PLAY_GAIN=0.35
# Lecture bureau (WAV modem) : debit / reechantillonnage
# VG_STUDIO_PLAY_SPEED=0.90
# VG_STUDIO_OUTPUT_RATE=44100
# Fin de phrase live (silence ms) et sensibilite VAD (RMS PCM, ~280)
# VG_LIVE_SILENCE_MS=750
# VG_LIVE_CHUNK_SEC=2.0
# VG_LIVE_VAD_RMS=280
# Filtre TV / musique / piece (1=on) — casque proche bouche
# VG_STUDIO_NOISE_GATE=1
# VG_LIVE_GATE_SNR=2.2
# VG_LIVE_BAND_RATIO=0.42
