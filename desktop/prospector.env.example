# VocalGuard Prospector — copier en prospector.env (racine repo ou dossier exe)
# Ne jamais committer prospector.env avec un vrai token.

# Base ProspectLab (sans /api/public) — stack LAN VocalGuard
PROSPECTLAB_URL=http://node15.lan:5000
PROSPECTLAB_TOKEN=

# SQLite (optionnel — defaut: Documents/VocalGuard/prospector/prospector.db)
# VG_PROSPECTOR_DATABASE_URL=sqlite:///C:/Users/you/Documents/VocalGuard/prospector/prospector.db

# Whisper node15
VG_STT_URL=http://node15.lan:8100
VG_STT_WS=ws://node15.lan:8100/ws/v1/transcribe
VG_STT_TOKEN=

# Modem USB local
VG_MODEM_COM=COM4
VG_MODEM_BAUD=230400

# Volume ecoute appel modem -> casque (0.05..1, defaut 0.22 si trop fort)
# VG_PROSPECTOR_LINE_GAIN=0.22
# Gain micro vers la ligne (defaut 0.85)
# VG_PROSPECTOR_MIC_GAIN=0.85
# Gain dans le fichier WAV (ligne souvent trop forte sans ca)
# VG_PROSPECTOR_RECORD_LINE_GAIN=0.30
# VG_PROSPECTOR_RECORD_MIC_GAIN=0.88
# VG_PROSPECTOR_RECORD_NOISE_GATE=0.034
# VG_PROSPECTOR_RECORD_NOISE_GATE_CLOSE=0.015
# VG_PROSPECTOR_RECORD_START_DELAY=0.35
# VG_PROSPECTOR_RECORD_ARM_ON_SPEECH=1
# VG_PROSPECTOR_RECORD_ARM_SPEECH_RMS=0.042
# VG_PROSPECTOR_RECORD_ARM_SPEECH_HITS=8
# VG_PROSPECTOR_RECORD_ARM_SPEECH_CREST=2.0
# VG_PROSPECTOR_RECORD_LINE_MIN_CREST=1.85

# Enregistrement appels (WAV stereo L=ligne R=micro, defaut: actif)
# VG_PROSPECTOR_RECORD_CALLS=1
# Dossier optionnel (defaut: Documents/VocalGuard/prospector/recordings)
# VG_PROSPECTOR_RECORD_DIR=C:/Users/you/Documents/VocalGuard/prospector/recordings

# Volume sons UI (0-100, sauve aussi dans ui_prefs.json)
# VG_PROSPECTOR_UI_VOLUME=65

# Theme UI: dark | light
# VG_PROSPECTOR_THEME=dark

# Hot reload dev : relance l appli quand un .py change (parent + enfant)
# Variable definie par scripts/launch_prospector.ps1 -HotReload
# VG_PROSPECTOR_HOT_RELOAD=1
# Enfant interne (ne pas definir a la main)
# VG_PROSPECTOR_DEV_CHILD=1
# Intervalle scan secondes (defaut 0.7)
# VG_PROSPECTOR_HOT_RELOAD_POLL=0.7
# Dossiers a surveiller (separateur ; sur Windows), defaut desktop/ et backend/core/
# VG_PROSPECTOR_HOT_RELOAD_PATHS=desktop;backend/core
